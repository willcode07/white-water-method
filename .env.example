# Optional local overrides for Create React App (copy to `.env`).
# Values are baked into the bundle at build time.

# Acuity scheduling URL — falls back to the default in CalendlyWidget.js if unset.
# REACT_APP_ACUITY_URL=https://app.acuityscheduling.com/schedule.php?owner=...

# Web3Forms (https://web3forms.com): when set, completing the movement assessment POSTs
# contact info + full report to your Web3Forms inbox (the email on that account).
# Restrict the access key to your production domain(s) in the Web3Forms dashboard.
# REACT_APP_WEB3FORMS_ACCESS_KEY=

# Instagram profile URL (optional; defaults to https://www.instagram.com until set).
# REACT_APP_INSTAGRAM_URL=https://www.instagram.com/yourprofile
